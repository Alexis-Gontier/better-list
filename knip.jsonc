{
  "$schema": "./node_modules/knip/schema.json",

  // Les hooks de l'agent sont des points d'entrée : c'est Claude Code qui les exécute.
  "entry": [".claude/hooks/*.mjs"],

  // Le plugin Playwright de knip ne voit que les `*.spec.ts` : les projets `setup` et `teardown`
  // déclarent leur `testMatch` en expression régulière, qu'il ne lit pas.
  "playwright": {
    "entry": ["e2e/**/*.spec.ts", "e2e/auth.{setup,teardown}.ts"]
  },

  // `src/components/ui/` est généré par shadcn et exporte volontairement plus qu'on ne consomme.
  // `scripts/legacy-import.ts` est un script lancé à la main (reprise des données de l'ancienne
  // app) : rien ne l'importe, c'est normal.
  "ignore": ["src/components/ui/**", "scripts/legacy-import.ts"],

  // Un export utilisé uniquement dans son propre fichier n'est pas du code mort.
  "ignoreExportsUsedInFile": true,

  // Gel : du code sans appelant **en attente d'un écran nommé**, pas du code inutile. Posé par
  // chemin, jamais en `exclude` global, pour que knip signale le code mort partout ailleurs.
  // Chaque entrée dit ce qui la lèvera ; une entrée dont la condition a expiré se supprime.
  "ignoreIssues": {
    // `formatListStatus`, `formatRanking` → les chiffres de la communauté sur la fiche.
    "src/features/media/lib/media-format.ts": ["exports"],
    // `FILTER_VOCABULARY_QUERY` → les facettes genres et tags de `/search`.
    "src/features/media/server/media.documents.ts": ["exports"],
    // `MediaTagOption` → les facettes ; `ScoreDistribution` → les chiffres de la communauté.
    "src/features/media/schemas/media.schema.ts": ["types"]
  }

  // Les règles restent au défaut (`error`) : un garde-fou laissé en `warn` finit par ne plus rien
  // garder.
}
