{
  "$schema": "./node_modules/knip/schema.json",

  // Les hooks de l'agent sont des points d'entrée : rien dans `src/` ne les importe, c'est
  // Claude Code qui les exécute.
  "entry": [".claude/hooks/*.mjs"],

  // `src/components/ui/` est généré par shadcn : ses composants exportent volontairement plus que
  // ce qu'on consomme, et les supprimer casserait la prochaine régénération. (`src/generated/`,
  // produit par Prisma, est déjà écarté par le .gitignore.)
  //
  // `scripts/legacy-import.ts` est un script de CLI lancé à la main (`tsx scripts/legacy-import.ts
  // <newUrl> <oldUrl>`) : rien ne l'importe, et c'est normal. Il est gardé au dépôt — la reprise
  // des données de l'ancienne app peut être rejouée sur une autre branche Neon.
  //
  // Il vivait dans `prisma/`, où seul son préfixe `_` le cachait de la CLI Prisma ; `scripts/` dit
  // ce qu'il est — un exécutable manuel — sans avoir à le camoufler, d'où la perte du préfixe.
  "ignore": ["src/components/ui/**", "scripts/legacy-import.ts"],

  // Un export utilisé uniquement dans son propre fichier n'est pas du code mort : c'est souvent
  // un helper testable ou une constante exposée pour un test à venir.
  "ignoreExportsUsedInFile": true

  // Les règles restent au défaut (`error`) : le réglage temporaire en `warn`, posé le temps que
  // `/search` et la première Server Action arrivent, a été retiré le 19 août 2026 — les deux
  // existent. Un garde-fou qu'on laisse en `warn` finit par ne plus rien garder.
}
