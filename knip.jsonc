{
  "$schema": "./node_modules/knip/schema.json",

  // Les hooks de l'agent sont des points d'entrée : rien dans `src/` ne les importe, c'est
  // Claude Code qui les exécute.
  "entry": [".claude/hooks/*.mjs"],

  // `src/components/ui/` est généré par shadcn : ses composants exportent volontairement plus que
  // ce qu'on consomme, et les supprimer casserait la prochaine régénération. (`src/generated/`,
  // produit par Prisma, est déjà écarté par le .gitignore.)
  //
  // `scripts/legacy-import.ts` est un script de CLI lancé à la main (`tsx scripts/legacy-import.ts
  // <newUrl> <oldUrl>`) : rien ne l'importe, et c'est normal. Il est gardé au dépôt — la reprise
  // des données de l'ancienne app peut être rejouée sur une autre branche Neon.
  //
  // Il vivait dans `prisma/`, où seul son préfixe `_` le cachait de la CLI Prisma ; `scripts/` dit
  // ce qu'il est — un exécutable manuel — sans avoir à le camoufler, d'où la perte du préfixe.
  "ignore": ["src/components/ui/**", "scripts/legacy-import.ts"],

  // Un export utilisé uniquement dans son propre fichier n'est pas du code mort : c'est souvent
  // un helper testable ou une constante exposée pour un test à venir.
  "ignoreExportsUsedInFile": true,

  // ─────────────────────────────────────────────────────────────────────────────────────────────
  // GEL DE LA MISE À BLANC — posé le 5 septembre 2026, élargi le même jour.
  //
  // Les dix routes de l'app sont des placeholders (`docs/STATE.md`). Ce qui reste sous `src/` est
  // donc, presque entièrement, du code **sans écran** : personne n'importe `media.documents.ts`
  // parce qu'aucune page n'interroge AniList, pas parce que ces documents GraphQL seraient devenus
  // faux. Le gel dit « en attente », jamais « inutile ».
  //
  // Ce qui est gelé a été choisi, pas subi. Trois natures, et rien d'autre :
  //
  //   1. **des contrats d'URL** — `calendar-params`, `profile-params`, `search-params` : ils fixent
  //      la forme des liens qu'on peut envoyer, une décision produit que la refonte ne rejoue pas ;
  //   2. **des schémas Zod et les types qui en dérivent** — la forme du domaine, dont `z.infer`
  //      tient lieu de `src/types/` (ARCHITECTURE.md) ;
  //   3. **des acquis coûteux à réécrire** — `media.documents.ts` et ses 488 lignes de GraphQL
  //      AniList, `lib/safe-action.ts` qui porte `actionClient` et `authActionClient`, et les
  //      helpers purs couverts par les 133 tests épargnés.
  //
  // Tout le rendu, lui, a été supprimé plutôt que gelé : geler du code qu'on sait devoir jeter,
  // c'est se promettre de le relire une fois de trop.
  //
  // Le gel est posé par **chemin**, jamais en `exclude` global : knip continue de signaler le code
  // mort partout ailleurs. Chaque entrée nomme l'écran qu'elle attend — c'est la liste de
  // reconstruction, et elle se vide par le bas.
  //
  // **Si ce bloc existe encore une fois les routes reconstruites, c'est un oubli, pas une
  // décision.** Le dernier à partir emporte `ignoreIssues` et `ignoreDependencies` avec lui.
  // ─────────────────────────────────────────────────────────────────────────────────────────────
  "ignoreIssues": {
    // ── Fichiers sans importateur ───────────────────────────────────────────────────────────────
    "src/app/(app)/calendar/_lib/calendar-params.ts": ["files"], // contrat d'URL — attend /calendar
    "src/app/(app)/u/[username]/_lib/profile-params.ts": ["files"], // contrat d'URL — attend /u
    "src/features/command/schemas/command.schema.ts": ["files"], // porte la règle du « +1 » — attend ⌘K
    "src/features/lists/schemas/lists.schema.ts": ["files"], // forme du domaine — attend /lists
    "src/features/tracking/lib/library-params.ts": ["files"], // contrat d'URL — attend /library
    "src/hooks/use-debounced-value.ts": ["files"], // attend une saisie de recherche
    "src/hooks/use-reduced-motion.ts": ["files"], // attend le carrousel de l'accueil
    "src/lib/safe-action.ts": ["files"], // actionClient / authActionClient — attend la 1re action

    // ── Exports et types sans appelant ──────────────────────────────────────────────────────────
    "src/features/media/lib/media-format.ts": ["exports"], // 9 formateurs — attendent leurs écrans
    // Le fichier a retrouvé un importateur avec la fiche du 6 septembre : il sort du gel « files »
    // pour le gel « exports ». `MEDIA_BY_ID_QUERY` est consommée ; les cinq autres — miroir,
    // catalogue, planning, recherche, vocabulaire de filtres — attendent leur écran.
    "src/features/media/server/media.documents.ts": ["exports"],
    "src/features/media/lib/media-freshness.ts": ["exports"], // bornes du miroir — attendent le cron
    // Le contrat d'URL a retrouvé un importateur avec la barre du 5 septembre, puis son panneau :
    // il sort du gel « files » pour le gel « exports ». La barre consomme les parseurs, les listes
    // d'options, `resolveSort` et `EMPTY_FILTERS` ; le panneau consomme les helpers de saison. Ne
    // restent gelés que **`loadSearchFilters` et `serializeSearchFilters`** — la lecture serveur
    // des filtres et la construction des liens de pagination, c'est-à-dire précisément ce que la
    // grille de résultats apportera. Cette entrée part avec elle.
    "src/features/media/lib/search-params.ts": ["exports"],
    "src/features/media/schemas/media.schema.ts": ["exports", "types"], // 5 schémas, 9 types
    "src/features/media/schemas/search-media.schema.ts": ["types"], // entrée et params de recherche
    "src/features/preferences/schemas/preferences.schema.ts": ["exports"], // défauts — attendent /settings
    "src/features/tracking/lib/entry-format.ts": ["exports"], // formatEventTime — attend le journal
    "src/features/tracking/schemas/tracking.schema.ts": ["exports"] // removeEntrySchema — attend l'action
  },

  // Quatre familles employées uniquement par de la présentation supprimée : `@dnd-kit` par le
  // réordonnancement de `/lists/[id]`, `embla` par les carrousels de l'accueil, `cmdk` et
  // `react-hotkeys-hook` par la palette `⌘K`. `next-safe-action` suit `lib/safe-action.ts`, gelé
  // ci-dessus : c'est le passage obligé de toute Server Action (CLAUDE.md), et il n'y en a plus
  // aucune.
  //
  // Elles restent au `package.json` plutôt que d'être désinstallées puis réinstallées : la refonte
  // les reprendra, et une version qui bouge entre-temps ferait rejouer un choix déjà tranché.
  "ignoreDependencies": [
    "@dnd-kit/.*",
    "cmdk",
    "embla-carousel.*",
    "next-safe-action",
    "react-hotkeys-hook"
  ]

  // Les règles restent au défaut (`error`) : le réglage temporaire en `warn`, posé le temps que
  // `/search` et la première Server Action arrivent, a été retiré le 19 août 2026 — les deux
  // existent. Un garde-fou qu'on laisse en `warn` finit par ne plus rien garder. Le gel ci-dessus
  // est la même dette sous une autre forme, et porte donc la même date de péremption.
}
