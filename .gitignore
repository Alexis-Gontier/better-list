# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/e2e/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/settings.local.json
# instantanés et journaux du navigateur piloté par Playwright
.playwright-mcp/
# outil local : rejoue une session existante dans le navigateur de test (voir l'en-tête du fichier)
scripts/dev-session-cookie.mjs

# lefthook — overrides locaux, non partagés
lefthook-local.yml

# prisma — client généré, reconstruit par le postinstall
/src/generated

# sorties de playwright-cli (instantanés, sessions — peuvent contenir des cookies)
.playwright-cli/
