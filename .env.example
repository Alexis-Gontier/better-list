# Base de données PostgreSQL (Neon).
# Utiliser la chaîne *poolée* (`-pooler` dans l'hôte) : l'app ouvre une connexion par instance
# serverless, et la base non poolée les épuise vite.
# `sslmode=verify-full` est explicite : `require` change de sémantique dans pg v9.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Better Auth — secret de signature des sessions.
# Générer avec : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Application OAuth GitHub (Settings → Developer settings → OAuth Apps).
# Callback en développement : http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# URL publique de l'app. Sert de baseURL à Better Auth et d'origine de confiance.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Jeton porteur des routes de cron (rafraîchissement du miroir AniList, docs/conception.md §4.1).
# Vercel l'envoie automatiquement en `Authorization: Bearer …` sur les crons déclarés dans
# vercel.json, à condition que la variable porte ce nom exact.
# Générer avec : node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
